{
    "version": "2.0.0",
    "tasks": [
        {
            // used by the "zxpaging in ZEsarUX" debugging configuration in launch.json
            "label": "zxpaging: build, and start the emulator for the debugger",
            "type": "shell",
            "command": "pwsh",
            "args": [ "-NoProfile", "-File", "${workspaceFolder}/build.ps1", "-Start", "zd" ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
        }
    ]
}
